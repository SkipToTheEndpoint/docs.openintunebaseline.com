---
import { getPlatforms } from '../lib/platforms.mjs';

const platforms = (await getPlatforms()).filter((p) => p.visibility !== 'hidden');
---

{
	platforms.map((p) => (
		<>
			<h2>{p.name}</h2>
			<table>
				<thead>
					<tr>
						<th>Version</th>
						<th>Channel</th>
						<th>Released</th>
						<th>Link</th>
					</tr>
				</thead>
				<tbody>
					{p.releases.map((r) => (
						<tr>
							<td>
								{r.version}
								{r.name ? ` - ${r.name}` : ''}
							</td>
							<td>{r.channel}</td>
							<td>{r.releaseDate}</td>
							<td>
								<a href={r.url}>{r.tag ?? r.branch}</a>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</>
	))
}
